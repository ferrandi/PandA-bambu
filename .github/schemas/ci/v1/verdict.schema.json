{
  "$id": "https://panda-re.github.io/schemas/ci/v1/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "merge_recommendation": {
      "enum": [
        "merge",
        "do-not-merge",
        "manual-review"
      ],
      "type": "string"
    },
    "overall_outcome": {
      "enum": [
        "pass",
        "fail",
        "neutral"
      ],
      "type": "string"
    },
    "policy_profile": {
      "const": "pull-request-default",
      "type": "string"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "neutral"
            ],
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "rule_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "severity": {
            "enum": [
              "blocking",
              "non-blocking"
            ],
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "outcome",
          "severity",
          "evidence",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 6,
      "type": "array"
    },
    "schema": {
      "const": "panda.ci.verdict",
      "type": "string"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "policy_profile",
    "overall_outcome",
    "merge_recommendation",
    "rules"
  ],
  "title": "PandA CI policy verdict",
  "type": "object"
}
