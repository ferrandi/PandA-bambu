{
  "$id": "https://panda-re.github.io/schemas/ci/v1/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_sha": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_sha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "completed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "configured_parallelism": {
      "minimum": 1,
      "type": "integer"
    },
    "container": {
      "additionalProperties": false,
      "properties": {
        "base_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "dockerfile_path": {
          "minLength": 1,
          "type": "string"
        },
        "dockerfile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dockerfile_path",
        "dockerfile_sha256",
        "base_image",
        "image_digest"
      ],
      "type": "object"
    },
    "documents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "schema": {
            "pattern": "^panda\\.ci\\.[a-z-]+$",
            "type": "string"
          },
          "schema_version": {
            "$ref": "common.schema.json#/$defs/schema_version"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "path",
          "schema",
          "schema_version",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 4,
      "type": "array"
    },
    "effective_build_profile": {
      "additionalProperties": false,
      "properties": {
        "assertions_enabled": {"type": ["boolean", "null"]},
        "build_type": {"type": ["string", "null"]},
        "configured_parallelism": {"minimum": 1, "type": "integer"},
        "cpu_target_profile": {"type": ["string", "null"]},
        "dockerfile_path": {"minLength": 1, "type": "string"},
        "dockerfile_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "optimized_flags": {"type": ["string", "null"]},
        "selected_frontend": {"type": ["string", "null"]},
        "tool_versions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "tool_id": {"$ref": "common.schema.json#/$defs/id"},
              "version": {"type": ["string", "null"]}
            },
            "required": ["tool_id", "version"],
            "type": "object"
          },
          "type": "array"
        },
        "warnings_as_errors": {"type": ["boolean", "null"]},
        "workflow_file": {"minLength": 1, "type": "string"},
        "workflow_file_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["optimized_flags", "build_type", "selected_frontend", "assertions_enabled", "warnings_as_errors", "configured_parallelism", "cpu_target_profile", "dockerfile_path", "dockerfile_sha256", "workflow_file", "workflow_file_sha256", "tool_versions"],
      "type": "object"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "execution_state": {
      "$ref": "common.schema.json#/$defs/execution_state"
    },
    "hosted_regression_suite": {
      "additionalProperties": false,
      "properties": {
        "action_exit_status": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "action_outcome": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "unknown"
          ],
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "container_setup_seconds": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "duration_measurement_method": {
          "enum": [
            "suite-monotonic-clock",
            "action-wall-clock",
            "runner-wall-clock",
            "unavailable"
          ],
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "execution_state": {
          "$ref": "common.schema.json#/$defs/execution_state"
        },
        "exit_status": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "failed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "failure_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "unknown"
          ],
          "type": "string"
        },
        "passed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "action_exit_status",
        "action_outcome",
        "execution_state",
        "outcome",
        "started_at",
        "completed_at",
        "exit_status",
        "duration_seconds",
        "duration_measurement_method",
        "container_setup_seconds",
        "failure_stage",
        "task_count",
        "passed_count",
        "failed_count"
      ],
      "type": "object"
    },
    "pull_request_number": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "ref": {
      "minLength": 1,
      "type": "string"
    },
    "repository": {
      "pattern": "^[^/]+/[^/]+$",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "runner": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "os",
        "architecture",
        "image"
      ],
      "type": "object"
    },
    "schema": {
      "const": "panda.ci.manifest",
      "type": "string"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "submodules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commit_sha": {
            "$ref": "common.schema.json#/$defs/sha"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "commit_sha"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "tool_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tool_id",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "implementation_commit": {
          "$ref": "common.schema.json#/$defs/sha"
        }
      },
      "required": [
        "file",
        "file_sha256",
        "implementation_commit"
      ],
      "type": "object"
    },
    "workflow_run_id": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "request_id",
    "workflow_run_id",
    "run_attempt",
    "execution_state",
    "started_at",
    "completed_at",
    "repository",
    "commit_sha",
    "base_sha",
    "ref",
    "pull_request_number",
    "event_type",
    "submodules",
    "workflow",
    "container",
    "runner",
    "tools",
    "configured_parallelism",
    "documents"
  ],
  "title": "PandA CI manifest",
  "type": "object"
}
