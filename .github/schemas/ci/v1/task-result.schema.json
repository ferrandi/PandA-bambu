{
  "$id": "https://panda-re.github.io/schemas/ci/v1/task-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "type": "array",
      "uniqueItems": true
    },
    "checks": {
      "items": {
        "$ref": "common.schema.json#/$defs/check"
      },
      "minItems": 1,
      "type": "array"
    },
    "configuration": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
        "assertions_enabled": {
          "type": "boolean"
        },
        "build_type": {
          "minLength": 1,
          "type": "string"
        },
        "cache_mode": {
          "minLength": 1,
          "type": "string"
        },
        "cache_matched_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_primary_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_restore": {
          "enum": [
            "exact",
            "prefix",
            "miss",
            "error",
            "skipped"
          ],
          "type": "string"
        },
        "cache_save_outcome": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "unknown"
          ],
          "type": "string"
        },
        "configured_parallelism": {
          "minimum": 1,
          "type": "integer"
        },
        "release_enabled": {
          "type": "boolean"
        },
        "selected_frontend": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "synthesis_smoke_enabled": {
          "type": "boolean"
        },
        "warnings_as_errors": {
          "type": "boolean"
        }
          },
          "required": [
            "configured_parallelism",
            "build_type",
            "release_enabled",
            "assertions_enabled",
            "warnings_as_errors",
            "selected_frontend",
            "synthesis_smoke_enabled",
            "cache_mode",
            "cache_restore",
            "cache_primary_key",
            "cache_matched_key",
            "cache_save_outcome"
          ],
          "type": "object"
        },
        {
          "$ref": "common.schema.json#/$defs/regression_result_configuration"
        }
      ]
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_status": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "common.schema.json#/$defs/execution_state"
        }
      },
      "required": [
        "state",
        "started_at",
        "completed_at",
        "exit_status"
      ],
      "type": "object"
    },
    "failure": {
      "$ref": "common.schema.json#/$defs/nullable_failure"
    },
    "metrics": {
      "items": {
        "$ref": "common.schema.json#/$defs/metric"
      },
      "minItems": 1,
      "type": "array"
    },
    "outcome": {
      "$ref": "common.schema.json#/$defs/outcome"
    },
    "results": {
      "$ref": "common.schema.json#/$defs/regression_results"
    },
    "schema": {
      "const": "panda.ci.task-result",
      "type": "string"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "stages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_ids": {
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "type": "array",
            "uniqueItems": true
          },
          "duration_seconds": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "execution_state": {
            "$ref": "common.schema.json#/$defs/execution_state"
          },
          "exit_status": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "failure": {
            "$ref": "common.schema.json#/$defs/nullable_failure"
          },
          "metric_ids": {
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "type": "array",
            "uniqueItems": true
          },
          "outcome": {
            "$ref": "common.schema.json#/$defs/outcome"
          },
          "stage_id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "stage_id",
          "execution_state",
          "outcome",
          "exit_status",
          "duration_seconds",
          "failure",
          "metric_ids",
          "artifact_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "task_type": {
      "enum": [
        "build",
        "regression"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "task_id",
    "task_type",
    "execution",
    "outcome",
    "failure",
    "configuration",
    "stages",
    "metrics",
    "checks",
    "artifacts"
  ],
  "title": "PandA CI task result",
  "type": "object"
}
