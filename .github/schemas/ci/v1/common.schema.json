{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "associated_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "github_artifact_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "producer_task": {
          "$ref": "#/$defs/id"
        },
        "retention_days": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "producer_task",
        "role",
        "path",
        "media_type",
        "available",
        "size_bytes",
        "sha256",
        "retention_days",
        "associated_stage",
        "github_artifact_name"
      ],
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "exists": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "starts": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "exists",
            "starts"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "failure": {
          "$ref": "#/$defs/nullable_failure"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "type": {
          "enum": [
            "executable-validation",
            "co-simulation",
            "schema-validation",
            "artifact-validation",
            "simulation",
            "result-verification"
          ],
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "type",
        "outcome",
        "failure",
        "details"
      ],
      "type": "object"
    },
    "execution_state": {
      "enum": [
        "queued",
        "running",
        "completed",
        "canceled",
        "timed_out",
        "infrastructure_error"
      ],
      "type": "string"
    },
    "failure": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "configuration",
            "compilation",
            "linkage",
            "installation",
            "execution",
            "verification",
            "resource",
            "timeout",
            "infrastructure",
            "canceled",
            "schema",
            "policy"
          ],
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/id"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "code",
        "stage",
        "message",
        "retryable",
        "evidence"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "type": "string"
    },
    "metric": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "minLength": 1,
          "type": "string"
        },
        "measurement_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "metric_id",
        "value",
        "unit",
        "aggregation",
        "scope",
        "measurement_method"
      ],
      "type": "object"
    },
    "nullable_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "skipped",
        "unknown",
        "neutral"
      ],
      "type": "string"
    },
    "regression_input": {
      "additionalProperties": false,
      "properties": {
        "example_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "type": "string"
        },
        "test_vector_kind": {
          "enum": [
            "cxx",
            "inline",
            "xml"
          ],
          "type": "string"
        },
        "test_vector_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_vector_value": {
          "minLength": 1,
          "type": "string"
        },
        "top_function": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "example_id",
        "source_path",
        "top_function",
        "test_vector_kind",
        "test_vector_value",
        "test_vector_path"
      ],
      "type": "object"
    },
    "regression_invocation": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "executable": {
          "minLength": 1,
          "type": "string"
        },
        "working_directory": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "executable",
        "working_directory",
        "arguments"
      ],
      "type": "object"
    },
    "regression_options": {
      "additionalProperties": false,
      "properties": {
        "bambu_parameters": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "clock_period": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "compiler": {
          "minLength": 1,
          "type": "string"
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "experimental_setup": {
          "type": [
            "string",
            "null"
          ]
        },
        "expose_globals": {
          "type": "boolean"
        },
        "inline_max_cost": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "interface": {
          "type": [
            "string",
            "null"
          ]
        },
        "language_standard": {
          "type": [
            "string",
            "null"
          ]
        },
        "optimization": {
          "type": [
            "string",
            "null"
          ]
        },
        "parallel_backend": {
          "minimum": 1,
          "type": "integer"
        },
        "simulate": {
          "type": "boolean"
        },
        "simulator": {
          "minLength": 1,
          "type": "string"
        },
        "test_vectors": {
          "type": [
            "string",
            "null"
          ]
        },
        "top_function": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bambu_parameters",
        "compiler",
        "simulator",
        "simulate",
        "top_function",
        "test_vectors",
        "optimization",
        "device",
        "clock_period",
        "interface",
        "language_standard",
        "parallel_backend",
        "experimental_setup",
        "expose_globals",
        "inline_max_cost"
      ],
      "type": "object"
    },
    "regression_request_configuration": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/id"
        },
        "frontend": {
          "additionalProperties": false,
          "properties": {
            "requested": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "requested"
          ],
          "type": "object"
        },
        "input": {
          "$ref": "#/$defs/regression_input"
        },
        "invocation": {
          "$ref": "#/$defs/regression_invocation"
        },
        "options": {
          "$ref": "#/$defs/regression_options"
        }
      },
      "required": [
        "category",
        "input",
        "frontend",
        "invocation",
        "options"
      ],
      "type": "object"
    },
    "regression_result_configuration": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/id"
        },
        "frontend": {
          "additionalProperties": false,
          "properties": {
            "requested": {
              "minLength": 1,
              "type": "string"
            },
            "selected": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "requested",
            "selected"
          ],
          "type": "object"
        },
        "input": {
          "$ref": "#/$defs/regression_input"
        },
        "invocation": {
          "$ref": "#/$defs/regression_invocation"
        },
        "options": {
          "$ref": "#/$defs/regression_options"
        }
      },
      "required": [
        "category",
        "input",
        "frontend",
        "invocation",
        "options"
      ],
      "type": "object"
    },
    "regression_results": {
      "additionalProperties": false,
      "properties": {
        "simulation": {
          "additionalProperties": false,
          "properties": {
            "completed": {
              "type": "boolean"
            },
            "execution_count": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "total_cycles": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "verified": {
              "type": "boolean"
            }
          },
          "required": [
            "completed",
            "verified",
            "execution_count",
            "total_cycles"
          ],
          "type": "object"
        },
        "synthesis": {
          "additionalProperties": false,
          "properties": {
            "completed": {
              "type": "boolean"
            },
            "rtl_artifact_count": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "completed",
            "rtl_artifact_count"
          ],
          "type": "object"
        }
      },
      "required": [
        "synthesis",
        "simulation"
      ],
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "type": "string"
    },
    "sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://panda-re.github.io/schemas/ci/v1/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PandA CI common definitions"
}
