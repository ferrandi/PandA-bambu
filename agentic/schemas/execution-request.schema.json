{
  "$id": "https://panda-re.github.io/schemas/agentic/execution-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "execution_id", "created_at", "task_id", "task_version", "task_digest", "role_id", "role_version", "role_digest", "base_commit", "profile_id", "adapter_id", "runtime_map_id", "runtime_map_version", "runtime_entry_id", "invocation_descriptor_digest", "routing_provenance", "executor_id", "executor_version", "input_handoff", "working_directory_policy", "result_collection", "wall_clock_timeout_seconds", "stdout_limit_bytes", "stderr_limit_bytes", "total_output_limit_bytes", "retention_policy", "authorization_state", "approved_operation", "approved_output_path"],
  "properties": {
    "schema": {"const": "evolvehls.agentic.execution-request"},
    "schema_version": {"const": "1.0"},
    "execution_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "task_id": {"$ref": "#/$defs/id"},
    "task_version": {"$ref": "#/$defs/version"},
    "task_digest": {"$ref": "#/$defs/digest"},
    "role_id": {"$ref": "#/$defs/id"},
    "role_version": {"$ref": "#/$defs/version"},
    "role_digest": {"$ref": "#/$defs/digest"},
    "base_commit": {"$ref": "#/$defs/commit"},
    "profile_id": {"$ref": "#/$defs/id"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "runtime_map_id": {"$ref": "#/$defs/id"},
    "runtime_map_version": {"$ref": "#/$defs/version"},
    "runtime_entry_id": {"$ref": "#/$defs/id"},
    "invocation_descriptor_digest": {"$ref": "#/$defs/digest"},
    "routing_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "resolver_version", "registry_id", "registry_version", "policy_id", "policy_version", "mode", "task_id", "role_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "resolver_version": {"$ref": "#/$defs/version"},
        "registry_id": {"$ref": "#/$defs/id"},
        "registry_version": {"$ref": "#/$defs/version"},
        "policy_id": {"$ref": "#/$defs/id"},
        "policy_version": {"$ref": "#/$defs/version"},
        "mode": {"enum": ["development", "evaluation", "ablation"]},
        "task_id": {"$ref": "#/$defs/id"},
        "role_id": {"$ref": "#/$defs/id"}
      }
    },
    "executor_id": {"const": "fixture-local"},
    "executor_version": {"const": "1.0"},
    "input_handoff": {"const": "fixture-json-file-v1"},
    "working_directory_policy": {"const": "detached-worktree-root"},
    "result_collection": {"const": "fixture-jsonl-and-artifact-v1"},
    "wall_clock_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "stdout_limit_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "stderr_limit_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "total_output_limit_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
    "retention_policy": {"const": "retain-for-inspection"},
    "authorization_state": {"const": "previewed-requires-explicit-confirmation"},
    "approved_operation": {"const": "write-fixture-execution-record-v1"},
    "approved_output_path": {"const": "agentic/fixtures/executions/fixture-local-output.txt"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 196},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}