{
  "$id": "https://panda-re.github.io/schemas/agentic/stage-routing-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved portable stage-routing decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "resolver_version", "registry_id", "registry_version", "policy_id", "policy_version", "mode", "task_id", "role_id", "selected", "fallback_authorized", "explanation", "rejected"],
  "properties": {
    "schema": {"const": "evolvehls.agentic.stage-routing-decision"},
    "schema_version": {"const": "1.0"},
    "resolver_version": {"type": "string", "minLength": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["development", "evaluation", "ablation"]},
    "task_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "selected": {"type": "object"},
    "fallback_authorized": {"type": "boolean"},
    "explanation": {"type": "array", "minItems": 1},
    "rejected": {"type": "array"}
  }
}