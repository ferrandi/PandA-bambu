{
  "$id":"https://panda-re.github.io/schemas/agentic/execution-plan.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","title":"Deterministic portable execution plan","type":"object","additionalProperties":false,
  "required":["schema","schema_version","resolver_version","mode","objective","role","selected","fallback_chain","fallback_policy","explanation","rejected","pins","ablation_dimensions"],
  "properties":{
    "schema":{"const":"evolvehls.agentic.execution-plan"},"schema_version":{"const":"1.0"},"resolver_version":{"type":"string","minLength":1},"mode":{"enum":["development","evaluation","ablation"]},"objective":{"enum":["lowest-cost-valid","fastest-valid","maximum-quality","balanced-quality-cost","maximum-agentic-reliability","independent-review","research-pinned"]},"role":{"type":"string","minLength":1},
    "selected":{"$ref":"#/$defs/unit"},"fallback_chain":{"type":"array","items":{"$ref":"#/$defs/unit"}},"fallback_policy":{"enum":["explicit-approval","disabled"]},"explanation":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"rejected":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["candidate","reasons"],"properties":{"candidate":{"$ref":"#/$defs/rejected_unit"},"reasons":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}}},
    "pins":{"type":"object","additionalProperties":false,"required":["catalog_snapshot","client_version","task_version","context_hash","base_revision","budgets"],"properties":{"catalog_snapshot":{"type":["string","null"]},"client_version":{"type":["string","null"]},"task_version":{"type":["string","null"]},"context_hash":{"type":["string","null"]},"base_revision":{"type":["string","null"]},"budgets":{"type":["object","null"]}}},
    "ablation_dimensions":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "allOf":[
    {"if":{"properties":{"mode":{"const":"evaluation"}}},"then":{"properties":{"fallback_chain":{"maxItems":0},"fallback_policy":{"const":"disabled"},"pins":{"properties":{"catalog_snapshot":{"type":"string","minLength":1},"client_version":{"type":"string","minLength":1},"task_version":{"type":"string","minLength":1},"context_hash":{"type":"string","minLength":1},"base_revision":{"type":"string","minLength":1},"budgets":{"type":"object"}}},"ablation_dimensions":{"maxItems":0}}}},
    {"if":{"properties":{"mode":{"const":"ablation"}}},"then":{"properties":{"fallback_policy":{"const":"disabled"},"ablation_dimensions":{"minItems":1}}}},
    {"if":{"properties":{"mode":{"const":"development"}}},"then":{"properties":{"fallback_policy":{"const":"explicit-approval"},"ablation_dimensions":{"maxItems":0}}}}
  ],
  "$defs":{"rejected_unit":{"type":"object","additionalProperties":false,"required":["client","provider","model","protocol","effort"],"properties":{"client":{"type":["string","null"]},"provider":{"type":["string","null"]},"model":{"type":"string","minLength":1},"protocol":{"type":["string","null"]},"effort":{"type":["string","null"]}}},"unit":{"type":"object","additionalProperties":false,"required":["client","provider","model","protocol","effort"],"properties":{"client":{"enum":["codex","claude-code","cline"]},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"protocol":{"enum":["openai-responses","anthropic-messages","openai-chat-completions"]},"effort":{"type":"string","minLength":1}}}}
}
