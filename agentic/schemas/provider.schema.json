{
  "$id":"https://panda-re.github.io/schemas/agentic/provider.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","title":"EvolveHLS portable agent provider profile","type":"object","additionalProperties":false,
  "required":["profile_id","schema_version","protocols","authentication","endpoint","models","capabilities","context","usage_reporting","retry","timeout"],
  "properties":{
    "profile_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*$"},"schema_version":{"const":"1.0"},
    "protocols":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{"openai-responses":{"$ref":"#/$defs/status"},"anthropic-messages":{"$ref":"#/$defs/status"},"openai-chat-completions":{"$ref":"#/$defs/status"}}},
    "authentication":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["class","token_env","headers"],"properties":{"class":{"const":"environment"},"token_env":{"$ref":"#/$defs/env"},"headers":{"$ref":"#/$defs/headers"}}},
      {"type":"object","additionalProperties":false,"required":["class","token_helper","headers"],"properties":{"class":{"const":"command"},"token_helper":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"headers":{"$ref":"#/$defs/headers"}}},
      {"type":"object","additionalProperties":false,"required":["class"],"properties":{"class":{"const":"none"}}}
    ]},
    "endpoint":{"type":"object","additionalProperties":false,"required":["env"],"properties":{"env":{"$ref":"#/$defs/env"}}},
    "models":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^[a-z][a-z0-9-]*$"},"additionalProperties":{"type":"object","additionalProperties":false,"required":["source","confidential"],"properties":{"source":{"type":"object","additionalProperties":false,"required":["env"],"properties":{"env":{"$ref":"#/$defs/env"}}},"confidential":{"type":"boolean"}}}},
    "capabilities":{"type":"object","additionalProperties":false,"required":["streaming","tool_calling","structured_output"],"properties":{"streaming":{"$ref":"#/$defs/status"},"tool_calling":{"$ref":"#/$defs/status"},"structured_output":{"$ref":"#/$defs/status"}}},
    "context":{"type":"object","additionalProperties":false,"required":["window_tokens","input_modalities"],"properties":{"window_tokens":{"type":["integer","null"],"minimum":1},"input_modalities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "usage_reporting":{"$ref":"#/$defs/status"},"retry":{"type":"object","additionalProperties":false,"required":["max_attempts","backoff_seconds"],"properties":{"max_attempts":{"type":"integer","minimum":1,"maximum":5},"backoff_seconds":{"type":"number","minimum":0}}},
    "timeout":{"type":"object","additionalProperties":false,"required":["seconds"],"properties":{"seconds":{"type":"number","exclusiveMinimum":0,"maximum":300}}}
  },
  "$defs":{"env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"status":{"enum":["supported","unsupported","unknown","probe-failed"]},"headers":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{"openai-responses":{"$ref":"#/$defs/header"},"anthropic-messages":{"$ref":"#/$defs/header"},"openai-chat-completions":{"$ref":"#/$defs/header"}}},"header":{"type":"object","additionalProperties":false,"required":["name","prefix"],"properties":{"name":{"type":"string","pattern":"^[A-Za-z0-9-]+$"},"prefix":{"type":"string"}}}}
}
