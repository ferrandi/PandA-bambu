{
  "$id": "https://panda-re.github.io/schemas/agentic/execution-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "execution_id", "execution_request_digest", "task_id", "task_version", "task_digest", "base_commit", "executor_id", "executor_version", "started_at", "completed_at", "execution_state", "exit_classification", "process_exit_code", "timed_out", "cancelled", "worktree_path", "input_handoff_digest", "stdout", "stderr", "result_path", "result_digest", "changed_files", "caller_checkout_preserved", "detached_worktree", "base_commit_preserved", "git_metadata_preserved", "submodules_preserved", "retention_state", "diagnostics", "commit_attempted", "push_attempted", "pull_request_attempted", "merge_attempted"],
  "properties": {
    "schema": {"const": "evolvehls.agentic.execution-receipt"},
    "schema_version": {"const": "1.0"},
    "execution_id": {"$ref": "#/$defs/id"},
    "execution_request_digest": {"$ref": "#/$defs/digest"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_version": {"$ref": "#/$defs/version"},
    "task_digest": {"$ref": "#/$defs/digest"},
    "base_commit": {"$ref": "#/$defs/commit"},
    "executor_id": {"const": "fixture-local"},
    "executor_version": {"const": "1.0"},
    "started_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "completed_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "execution_state": {"enum": ["completed", "failed", "cancelled"]},
    "exit_classification": {"enum": ["succeeded", "executor-failed", "timed-out", "cancelled", "output-limit", "invalid-result", "worktree-violation", "launch-failed", "executor-not-implemented"]},
    "process_exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "cancelled": {"type": "boolean"},
    "worktree_path": {"$ref": "#/$defs/path"},
    "input_handoff_digest": {"$ref": "#/$defs/digest"},
    "stdout": {"$ref": "#/$defs/stream"},
    "stderr": {"$ref": "#/$defs/stream"},
    "result_path": {"$ref": "#/$defs/path"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "changed_files": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/change"}},
    "caller_checkout_preserved": {"type": "boolean"},
    "detached_worktree": {"type": "boolean"},
    "base_commit_preserved": {"type": "boolean"},
    "git_metadata_preserved": {"type": "boolean"},
    "submodules_preserved": {"type": "boolean"},
    "retention_state": {"enum": ["retained", "cleanup-pending", "safely-removed"]},
    "diagnostics": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "commit_attempted": {"const": false, "description": "Framework attestation only; not proof about an arbitrary hostile executable."},
    "push_attempted": {"const": false, "description": "Framework attestation only; not proof about an arbitrary hostile executable."},
    "pull_request_attempted": {"const": false, "description": "Framework attestation only; not proof about an arbitrary hostile executable."},
    "merge_attempted": {"const": false, "description": "Framework attestation only; not proof about an arbitrary hostile executable."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 196},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!~)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 512},
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_bytes", "observed_bytes", "truncated", "digest", "evidence_path"],
      "properties": {
        "captured_bytes": {"type": "integer", "minimum": 0, "maximum": 524288},
        "observed_bytes": {"type": "integer", "minimum": 0, "maximum": 524288},
        "truncated": {"type": "boolean"},
        "digest": {"$ref": "#/$defs/digest"},
        "evidence_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change", "digest", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "change": {"enum": ["added", "modified", "deleted", "type-changed"]},
        "digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "size": {"type": ["integer", "null"], "minimum": 0, "maximum": 1073741824}
      }
    }
  }
}