{
  "$id": "https://panda-re.github.io/schemas/agentic/client-runtime-map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical client runtime supplement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "runtime_map_id", "version", "entries"],
  "properties": {
    "schema": {"const": "evolvehls.agentic.client-runtime-map"},
    "schema_version": {"const": "1.0"},
    "runtime_map_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_entry_id",
          "profile_id",
          "adapter_id",
          "client_template",
          "execution_path"
        ],
        "properties": {
          "runtime_entry_id": {"$ref": "#/$defs/id"},
          "profile_id": {"$ref": "#/$defs/id"},
          "adapter_id": {"$ref": "#/$defs/id"},
          "client_template": {"$ref": "#/$defs/id"},
          "execution_path": {"$ref": "#/$defs/id"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    }
  }
}