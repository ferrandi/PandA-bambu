{
  "$id": "https://panda-re.github.io/schemas/agentic/role.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable agent role",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "role_id", "version", "mandatory_capabilities", "preferred_capabilities", "default_objective", "permitted_modes", "minimum_confidence"],
  "properties": {
    "schema": {"const": "evolvehls.agentic.role"},
    "schema_version": {"const": "1.0"},
    "role_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "mandatory_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "preferred_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "default_objective": {"type": "string", "minLength": 1},
    "permitted_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["development", "evaluation", "ablation"]}},
    "minimum_confidence": {"enum": ["declared", "inferred", "observed", "historically-validated", "unknown"]}
  }
}