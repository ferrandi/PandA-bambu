{
  "$id": "https://panda-re.github.io/schemas/agentic/selection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persisted portable model selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "selection_id", "created_at", "catalog_snapshot", "role_id", "role_version", "execution_plan"],
  "properties": {
    "schema": {"const": "evolvehls.agentic.selection"},
    "schema_version": {"const": "1.0"},
    "selection_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "catalog_snapshot": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "role_version": {"type": "string", "minLength": 1},
    "execution_plan": {"type": "object"}
  }
}