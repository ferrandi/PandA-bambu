#!/usr/bin/env python3
"""Preflight the temporary Cline bootstrap without printing secret values."""
from __future__ import annotations

import argparse
import hashlib
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path


def digest(value: str | None) -> str | None:
    if value is None:
        return None
    return hashlib.sha256(value.encode()).hexdigest()


def daemon_pids() -> list[int]:
    result = subprocess.run(["pgrep", "-f", r"[.]cline .*--cline-hub-daemon"], text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)
    pids: list[int] = []
    for line in result.stdout.splitlines():
        try:
            pids.append(int(line.strip()))
        except ValueError:
            pass
    return pids


def read_environ(pid: int) -> dict[str, str]:
    path = Path(f"/proc/{pid}/environ")
    try:
        raw = path.read_bytes()
    except (OSError, PermissionError):
        return {}
    env: dict[str, str] = {}
    for part in raw.split(b"\0"):
        if b"=" not in part:
            continue
        key, value = part.split(b"=", 1)
        env[key.decode(errors="replace")] = value.decode(errors="replace")
    return env


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", default=os.environ.get("PAF_REPO", os.getcwd()))
    parser.add_argument("--publish", action="store_true")
    parser.add_argument("--restart-daemon-on-key-mismatch", action="store_true")
    parser.add_argument("--profiles", nargs="*", default=["~/.cline-sol", "~/.cline-terra", "~/.cline-opus", "~/.cline-sonnet"])
    args = parser.parse_args()

    failures: list[str] = []
    warnings: list[str] = []
    for tool in ("git", "cline", "python3") + (("gh",) if args.publish else ()):  # type: ignore[operator]
        if shutil.which(tool) is None:
            failures.append(f"missing required tool: {tool}")
    repo = Path(args.repo).expanduser().resolve()
    if subprocess.run(["git", "-C", str(repo), "rev-parse", "--is-inside-work-tree"],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode != 0:
        failures.append(f"not a Git repository: {repo}")
    for profile in args.profiles:
        path = Path(profile).expanduser()
        if not path.is_dir():
            failures.append(f"missing Cline profile: {path}")

    lite = os.environ.get("LITELLM_API_KEY")
    openai = os.environ.get("OPENAI_API_KEY")
    if not lite:
        failures.append("LITELLM_API_KEY is missing")
    if not openai:
        failures.append("OPENAI_API_KEY is missing")
    if lite and openai and lite != openai:
        warnings.append("LITELLM_API_KEY and OPENAI_API_KEY differ; verify this is intentional")

    mismatched: list[int] = []
    for pid in daemon_pids():
        env = read_environ(pid)
        daemon_lite = env.get("LITELLM_API_KEY")
        daemon_openai = env.get("OPENAI_API_KEY")
        if not daemon_lite or not daemon_openai:
            mismatched.append(pid)
            continue
        if lite and (digest(daemon_lite) != digest(lite) or digest(daemon_openai) != digest(openai)):
            mismatched.append(pid)
    if mismatched and args.restart_daemon_on_key_mismatch:
        for pid in mismatched:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        time.sleep(2)
        warnings.append(f"restarted {len(mismatched)} Cline daemon process(es) with stale/missing credentials")
    elif mismatched:
        failures.append(
            "Cline daemon credential environment is missing or mismatched; rerun with "
            "--restart-daemon-on-key-mismatch or restart the daemon manually"
        )

    if args.publish and shutil.which("gh"):
        if subprocess.run(["gh", "auth", "status"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, check=False).returncode != 0:
            failures.append("GitHub CLI is not authenticated")

    for warning in warnings:
        print(f"WARNING: {warning}")
    if failures:
        for failure in failures:
            print(f"ERROR: {failure}", file=sys.stderr)
        return 1
    print("PAF Cline bootstrap preflight passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
